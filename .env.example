# Copy to .env.deploy and fill in. `npm run deploy` sources this file.
# Never commit the filled-in version (it is gitignored).

# Hostname the Worker is published on (must be a zone on your account).
CF_DOMAIN=ssh.example.com

# `cf kv namespaces create --title ssh-worker-servers` → id
CF_KV_NAMESPACE_ID=

# `cf zero-trust organization get` → auth_domain
CF_ACCESS_TEAM_DOMAIN=

# `cf zero-trust access applications list` → aud of the self-hosted app
CF_ACCESS_AUD=

# Comma separated allowlist; empty means "anyone who passes Access"
CF_ALLOWED_EMAILS=you@example.com
